PROJECT_NAME="Lenny Growth Assistant"
API_V1_PREFIX="/api/v1"

# ─── Database Configuration ───────────────────────────────────────────────────
# Supabase PostgreSQL (remote) or local Docker Postgres
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/lenny_db"

# ─── Default AI Provider ──────────────────────────────────────────────────────
# Supported: openai | anthropic | groq | gemini | openrouter | ollama
AI_PROVIDER="ollama"
DEFAULT_MODEL="qwen2.5-coder:3b"

# ─── Embedding Configuration ──────────────────────────────────────────────────
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIM=768

# ─── API Keys (configure only the providers you plan to use) ──────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# ─── Local Ollama ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]'
